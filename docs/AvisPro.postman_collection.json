      "item": [
        {
          "name": "Inscription entreprise",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nouveau Patron\",\n  \"email\": \"patron@exemple.bj\",\n  \"password\": \"motdepasse\"\n}"
            }
          }
        },
        {
          "name": "Connexion (démo entreprise)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Enregistre automatiquement le jeton dans la variable {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@avispro.bj\",\n  \"password\": \"demo1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.token) { pm.collectionVariables.set(\"token\", d.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion (démo modérateur)",
          "request": {
            "method": "POST",
